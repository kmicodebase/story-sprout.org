# Cloudflare Pages reads this file. It has no effect on the local dev server, so
# verify these on the *.pages.dev preview before pointing the domain at it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Everything this site loads is same-origin: self-hosted fonts, local images,
  # local PDFs. 'unsafe-inline' is needed because Astro inlines its component
  # styles and the small reader script. frame-src/object-src cover the PDF
  # viewers on the research and story pages. connect-src/form-action stay 'self'
  # because the webinar sign-up posts to this site's own /api/signup. The one
  # exception is us.i.posthog.com for analytics; posthog-js is bundled with the
  # site, so script-src does not need widening.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self'; object-src 'self'; connect-src 'self' https://us.i.posthog.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Astro fingerprints these filenames, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Generated images keep stable names, so cache for a day and revalidate.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

# Storybooks, curriculum decks, and the paper. Same reasoning.
/documents/*
  Cache-Control: public, max-age=86400, must-revalidate
