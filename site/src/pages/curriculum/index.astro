---
import BaseLayout from '../../layouts/BaseLayout.astro'
import EmptyState from '../../components/EmptyState.astro'
import { getCurriculum } from '../../lib/content'
import { assetUrl } from '../../lib/assets'
import { siteConfig } from '../../config/site'

const all = await getCurriculum()
const current = all.filter((item) => !item.data.archived)
const archived = all.filter((item) => item.data.archived)
---

<BaseLayout
  title="Curriculum"
  description="Story Sprout session plans and slides for educators and families."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Curriculum</p>
      <h1>Session plans and slides</h1>
      <p class="lede">
        The Story Sprout curriculum walks young writers through the whole creative process:
        brainstorming, character creation, drafting, revision, and illustration.
      </p>
      <ul class="facts">
        <li>Free to download and use</li>
        <li>Ages 7–13</li>
        <li>Runs as 4 to 8 sessions</li>
      </ul>

      {
        current.length === 0 ? (
          <EmptyState title="No curriculum published yet">
            <p>Session materials will appear here once they are published.</p>
          </EmptyState>
        ) : (
          <ul class="grid grid--auto curriculum">
            {current.map((item) => (
              <li class="card resource">
                {item.data.thumbnail && (
                  <span class="resource__frame">
                    <img
                      src={assetUrl(item.data.thumbnail)}
                      alt={item.data.thumbnailAlt ?? ''}
                      loading="lazy"
                      decoding="async"
                      width="450"
                      height="300"
                    />
                  </span>
                )}
                <div class="resource__body">
                  <h2 class="resource__title">{item.data.title}</h2>
                  <p class="muted">{item.data.summary}</p>
                  <dl class="resource__meta">
                    {item.data.audience && (
                      <div>
                        <dt>For</dt>
                        <dd>{item.data.audience}</dd>
                      </div>
                    )}
                    {item.data.version && (
                      <div>
                        <dt>Version</dt>
                        <dd>{item.data.version}</dd>
                      </div>
                    )}
                  </dl>
                  <div class="resource__actions">
                    {item.data.pdfUrl && (
                      <a
                        class="btn btn--outline btn--small"
                        href={assetUrl(item.data.pdfUrl)}
                        data-cta="overview"
                        data-asset-id={`session-${item.data.sessionNumber ?? 0}`}
                      >
                        Download PDF
                      </a>
                    )}
                    {item.data.slidesUrl && (
                      <a class="btn btn--outline btn--small" href={item.data.slidesUrl} rel="noopener">
                        View slides
                      </a>
                    )}
                    {item.data.teacherNotesUrl && (
                      <a class="btn btn--outline btn--small" href={item.data.teacherNotesUrl}>
                        Teacher notes
                      </a>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )
      }

      <aside class="license">
        <h2>Use these however you need to</h2>
        <p>
          The session materials on this page are shared under a{' '}
          <a href={siteConfig.license.url} rel="license noopener">{siteConfig.license.name}</a>{' '}
          licence. Use them, adapt them, remix them for your own class, and share what you
          make — for non-commercial teaching, with credit to Story Sprout.
        </p>
        <p class="license__note">
          The children's storybooks are not covered by this licence. Those belong to the
          children who wrote them.
        </p>
      </aside>

      {
        archived.length > 0 && (
          <div class="archive">
            <h2>Previous versions</h2>
            <ul>
              {archived.map((item) => (
                <li>
                  {item.data.pdfUrl ? (
                    <a href={assetUrl(item.data.pdfUrl)}>{item.data.title}</a>
                  ) : (
                    item.data.title
                  )}
                  <span class="badge">Archived</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .facts {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .facts li {
    background: var(--color-lavender-tint);
    color: var(--color-purple-text);
    font-weight: 800;
    font-size: 0.88rem;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-button);
  }

  .curriculum {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .resource {
    display: flex;
    flex-direction: column;
  }

  .resource__frame {
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--color-lavender-soft);
    border-bottom: 1px solid var(--color-border);
  }

  .resource__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .resource__body {
    padding: 1.15rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }

  .resource__title {
    font-size: 1.15rem;
    margin: 0;
  }

  .resource__body p {
    margin: 0;
    font-size: 0.95rem;
  }

  .resource__meta {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
    display: grid;
    gap: 0.15rem;
  }

  .resource__meta div {
    display: flex;
    gap: 0.4rem;
  }

  .resource__meta dt {
    font-weight: 800;
  }

  .resource__meta dt::after {
    content: ':';
  }

  .resource__meta dd {
    margin: 0;
  }

  .resource__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.9rem;
  }

  .license {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--color-lavender-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: clamp(1.35rem, 3vw, 1.9rem);
    max-width: 46rem;
  }

  .license h2 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .license p {
    margin: 0;
    color: var(--color-muted);
  }

  .license__note {
    margin-top: 0.75rem !important;
    font-size: 0.92rem;
  }

  .archive {
    margin-top: 3rem;
  }

  .archive ul {
    list-style: none;
    padding: 0;
  }

  .archive li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }
</style>
