---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found">
  <section class="section">
    <div class="wrap notfound">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lede">
        The link may be out of date, or the page may have moved. Here is where to look instead.
      </p>
      <ul class="notfound__links">
        <li><a href="/">Home</a></li>
        <li><a href="/stories/">Story library</a></li>
        <li><a href="/curriculum/">Curriculum</a></li>
        <li><a href="/about/">About Story Sprout</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 44rem;
  }

  .notfound__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    font-weight: 700;
  }
</style>
