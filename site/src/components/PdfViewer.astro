---
/**
 * Opens a document in a modal reader on the same page, alongside a plain
 * download link.
 *
 * Progressive enhancement: with JavaScript off — or if <dialog> is missing —
 * the trigger stays an ordinary link straight to the PDF, so the document is
 * never unreachable. The script below upgrades it in place.
 *
 * The iframe has no src until the reader is first opened, so a listing page
 * costs nothing extra to load. Native <dialog>.showModal() gives us the focus
 * trap, Escape-to-close, and inert background for free.
 */
interface Props {
  url: string
  /** Used for the reader's accessible name and its title bar. */
  title: string
  label?: string
  /** Matches the surrounding buttons. */
  variant?: 'primary' | 'outline'
}

const { url, title, label = 'Read it here', variant = 'outline' } = Astro.props
---

<div class="pdf-viewer" data-pdf-viewer>
  <a class:list={['btn', `btn--${variant}`, 'btn--small']} href={url} data-pdf-open>
    {label}
  </a>

  <dialog class="reader" data-pdf-dialog aria-label={`${title} — document reader`}>
    <div class="reader__bar">
      <p class="reader__title">{title}</p>
      <div class="reader__actions">
        <a class="btn btn--outline btn--small" href={url} download>Download</a>
        <button type="button" class="reader__close" data-pdf-close>
          Close<span class="visually-hidden"> the document reader</span>
        </button>
      </div>
    </div>

    <iframe class="reader__frame" title={`${title} (PDF)`} data-pdf-frame data-src={url}></iframe>

    <p class="reader__fallback">
      If the document does not appear, <a href={url}>open the PDF directly</a>.
    </p>
  </dialog>
</div>

<style>
  .pdf-viewer {
    display: contents;
  }

  .reader {
    width: min(72rem, 94vw);
    height: min(90vh, 60rem);
    padding: 0;
    border: none;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }

  .reader::backdrop {
    background: rgb(45 32 26 / 55%);
  }

  .reader[open] {
    display: flex;
    flex-direction: column;
  }

  .reader__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-lavender-soft);
  }

  .reader__title {
    margin: 0;
    font-weight: 800;
    font-size: 0.98rem;
    line-height: 1.3;
    /* Long paper titles must not push the controls off screen. */
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reader__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .reader__close {
    font: inherit;
    font-weight: 800;
    font-size: 0.9rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-button);
    border: 2px solid transparent;
    background: var(--color-purple);
    color: #fff;
    cursor: pointer;
  }

  .reader__close:hover {
    background: var(--color-purple-dark);
  }

  .reader__frame {
    flex: 1;
    width: 100%;
    border: none;
    background: var(--color-lavender-soft);
  }

  .reader__fallback {
    margin: 0;
    padding: 0.7rem 1.1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.88rem;
    color: var(--color-muted);
    background: var(--color-surface);
  }

  @media (max-width: 40rem) {
    .reader {
      width: 100vw;
      height: 100vh;
      max-width: none;
      max-height: none;
      border-radius: 0;
    }

    .reader__title {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-pdf-viewer]')) {
    const trigger = root.querySelector<HTMLAnchorElement>('[data-pdf-open]')
    const dialog = root.querySelector<HTMLDialogElement>('[data-pdf-dialog]')
    const frame = root.querySelector<HTMLIFrameElement>('[data-pdf-frame]')
    const close = root.querySelector<HTMLButtonElement>('[data-pdf-close]')

    // Leave the plain link alone if anything is missing or unsupported.
    if (!trigger || !dialog || !frame || typeof dialog.showModal !== 'function') continue

    trigger.addEventListener('click', (event) => {
      // Let modified clicks (new tab, download) behave normally.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      event.preventDefault()

      // Fetch the document only on first open.
      if (!frame.src) frame.src = frame.dataset.src ?? ''
      dialog.showModal()
    })

    close?.addEventListener('click', () => dialog.close())

    // Clicking the backdrop closes; clicks inside the panel must not.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })

    // Native <dialog> restores focus to the trigger on close by itself.
  }
</script>
