---
/**
 * The Kindness Matters Inc bridge, redrawn as a flat SVG from the logo on
 * kindnessmattersinc.org. Their published logo files are glowing renders on a
 * dark ground and turn to mush at icon size. Swap in an official vector here
 * if KMI supplies one.
 */
interface Props {
  size?: number
}
const { size = 26 } = Astro.props
---

<svg width={size} height={Math.round((size * 28) / 48)} viewBox="0 0 48 28" aria-hidden="true" focusable="false">
  <path d="M2 9.5Q24 -1.5 46 9.5V12.3Q24 1.3 2 12.3Z" fill="#1e5a9e"></path>
  <path
    d="M2 15Q24 4 46 15V27H43.5V23A4.5 4.5 0 0 0 34.5 23V27H31V23A7 7 0 0 0 17 23V27H13.5V23A4.5 4.5 0 0 0 4.5 23V27H2Z"
    fill="#1e5a9e"></path>
</svg>
