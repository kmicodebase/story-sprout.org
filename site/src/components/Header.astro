---
import Logo from './Logo.astro'
import { navLinks, siteConfig } from '../config/site'

const path = Astro.url.pathname
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''))
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Story Sprout — home">
      <Logo />
    </a>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      <span class="visually-hidden">Menu</span>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={siteConfig.teacherUrl} rel="noopener">Teacher</a>
        </li>
        <li>
          <a class="btn btn--primary btn--small" href={siteConfig.platformUrl} rel="noopener"
             data-cta="studio" data-cta-location="header">
            Try Story Sprout Studio
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  .site-header__brand {
    text-decoration: none;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.45rem;
    color: var(--color-ink);
  }

  .site-nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.8vw, 1.6rem);
    margin: 0;
    padding: 0;
  }

  .site-nav__list a:not(.btn) {
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.98rem;
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
  }

  .site-nav__list a:not(.btn):hover {
    color: var(--color-purple-text);
  }

  .site-nav__list a[aria-current='page'] {
    color: var(--color-purple-text);
    border-bottom-color: var(--color-purple);
  }

  /* Mobile: the toggle appears and the list becomes a stacked panel. */
  @media (max-width: 62rem) {
    .site-header__inner {
      flex-wrap: wrap;
    }

    .site-nav {
      flex-basis: 100%;
      display: none;
    }

    .site-nav[data-open] {
      display: block;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 0.75rem;
    }

    .site-nav__list li + li {
      border-top: 1px solid var(--color-border);
    }

    .site-nav__list a:not(.btn) {
      display: block;
      padding: 0.85rem 0.25rem;
      border-bottom: none;
    }

    .site-nav__list li:last-child {
      border-top: none;
      padding-top: 0.85rem;
    }

    .site-nav__list .btn {
      justify-content: center;
    }
  }

  @media (min-width: 62.0625rem) {
    .site-header__toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const nav = document.getElementById('primary-nav')

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      nav.toggleAttribute('data-open', open)
    }

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true')
    })

    // Escape closes the panel and returns focus to the control that opened it.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        toggle.focus()
      }
    })
  }
</script>
