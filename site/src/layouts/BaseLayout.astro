---
import '@fontsource-variable/nunito'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PendingBanner from '../components/PendingBanner.astro'
import Analytics from '../components/Analytics.astro'
import { siteConfig } from '../config/site'
import { assetUrl } from '../lib/assets'

interface Props {
  title: string
  description?: string
  /** Path to an OG image under /public. Falls back to the hero illustration. */
  image?: string
  /** Set on pages that should not be indexed (e.g. unfinished donate page). */
  noindex?: boolean
}

const {
  title,
  description = siteConfig.description,
  image = '/assets/illustrations/hero-classroom.png',
  noindex = false,
} = Astro.props

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`
const canonical = new URL(Astro.url.pathname, siteConfig.canonicalUrl)
const ogImage = new URL(assetUrl(image) ?? image, siteConfig.canonicalUrl)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'EducationalOrganization',
        name: siteConfig.name,
        url: siteConfig.canonicalUrl,
        description: siteConfig.description,
        parentOrganization: {
          '@type': 'NonprofitOrganization',
          name: siteConfig.parentOrg.name,
          url: siteConfig.parentOrg.url,
        },
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <PendingBanner />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
