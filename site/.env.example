# Copy to .env and fill in. Analytics stays off unless all three are set.
#
# The site is built locally and deployed as static files, so these are read at
# BUILD time — setting them in the Cloudflare dashboard does not affect the
# client bundle. Change them here, rebuild, redeploy.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_ANALYTICS_ENABLED=true
